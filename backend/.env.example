# ExplainLab 后端环境配置示例
# 复制为 backend/.env 后按需修改。.env 不入库，密钥绝不写入前端。

# 数据库：开发默认 SQLite
DATABASE_URL=sqlite:///./data/explainlab.db
# 部署切换 PostgreSQL（取消注释并填写真实连接信息）：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/explainlab

# 允许的前端跨域源（JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 模型适配层：M1 接入 OpenAI 兼容供应商（DeepSeek / 通义千问 / Kimi / OpenAI 等）
# 密钥仅后端持有，绝不写入前端。BASE_URL 填供应商官方真实地址，原样使用，不经任何代理。
# 未配置时对话与提取接口如实返回 503，其余功能不受影响。
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=deepseek-chat

# M3 向量来源（独立于聊天配置）：支持 /embeddings 的 OpenAI 兼容端点。
# 注意：DeepSeek 聊天端点无 /embeddings，不能复用；需另选支持 embed 的供应商
# （如 SiliconFlow / 智谱 / 通义 / OpenAI 等）。BASE_URL 填官方真实地址，原样使用，不经代理。
# 三项均填写后向量通道才开启；未配置时仅全文检索，健康检查如实上报 not_configured。
# 可用 `uv run python scripts/probe_embed.py` 只读探测能力（supported/unsupported）。
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=