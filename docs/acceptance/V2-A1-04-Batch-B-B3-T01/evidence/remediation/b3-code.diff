+            )
+            try:
+                write_all(fd, memoryview(payload))
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+            os.replace(temp, path)
+            self._sync_directory(path.parent)
+        except OSError as exc:
+            with contextlib.suppress(OSError):
+                temp.unlink()
+            raise _staging_error(ATTACHMENT_WRITE_FAILED) from exc
