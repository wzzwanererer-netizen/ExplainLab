+    def _regular_relative_files(self, staging_dir: Path) -> set[str]:
+        found: set[str] = set()
+        stack = [staging_dir]
+        while stack:
+            current = stack.pop()
+            try:
+                entries = list(os.scandir(current))
+            except OSError as exc:
+                raise _staging_error(ATTACHMENT_STAGING_INVALID) from exc
+            for entry in entries:
