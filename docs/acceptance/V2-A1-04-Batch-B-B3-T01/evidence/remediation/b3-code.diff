+                try:
+                    items = coerce_manifest_items(envelope.attachments)
+                except AttachmentStagingError:
+                    return None
+                staging_ids = {item.staging_id for item in items}
+                if len(staging_ids) != 1:
+                    return None
+                refs.update(staging_ids)
+            return refs
+        except Exception:
+            return None
+        finally:
+            if session is not None:
+                session.close()
