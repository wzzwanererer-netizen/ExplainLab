+    @staticmethod
+    def _publish_archive_no_overwrite(tmp: Path, target: Path, payload: bytes) -> None:
+        """原子发布归档且绝不覆盖已有归档（P2-06）。
+
+        先硬链接（目标存在则 ``FileExistsError``），再复核字节一致；不依赖
+        「检查 target.exists() 之后到 replace 之前无人创建」这一未验证假设。
+        硬链接不受支持时退回 O_EXCL 独占创建；已有目标仍不覆盖。
+        """
+        try:
+            os.link(tmp, target)
+        except FileExistsError:
+            pass
+        except OSError:
+            try:
+                target_fd = os.open(
+                    target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | _BINARY, 0o600
