+                )
+            else:
+                connection = engine.connect()
+        except (PoolTimeout, DatabaseDeadline) as exc:
+            raise SQLiteWriteTimeout("SQLite connection checkout budget exhausted") from exc
+        with connection:
+            _sqlite_remaining_ms(deadline)
+            yield connection
+
