+    warning = next(
+        w for w in report.warnings if w.code == LinkWarningCode.CROSS_SPACE_BINDING_RESTORED
+    )
+    for fragment in ("p1", "p2", str(b.id), "B", "别名"):
+        assert fragment in warning.message
+    # 对照 J：同一对条目无提示时自动解析必为 missing（跨空间绑定只来自历史意图）。
