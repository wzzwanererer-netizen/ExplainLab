+def _apply(plan: LinkRebuildPlan, session: Session):
+    """apply 要求事务所有权（§8.3.7 步①）：基线快照等只读操作会 autobegin
+    读事务，先 commit 释放（只读提交，不改数据），再交给 apply 自开事务。"""
+    session.commit()
+    return apply_link_key_plan(plan, session)
