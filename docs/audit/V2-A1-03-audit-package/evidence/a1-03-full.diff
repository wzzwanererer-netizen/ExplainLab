+def _collision_source(items, links, sync, title, t1, t2):
+    a = _item(items, title, content=f"[[{t1}]] [[{t2}]]")
+    b1 = _item(items, t1)
+    b2 = _item(items, t2)
+    sync.sync(a, a.content)
+    assert all(r.resolution == LinkResolution.RESOLVED for r in links.list_links(a.id))
+    return a, b1, b2
