+    counter = _QueryCounter(engine)
+    # ① begin_nested 内受守卫写入 → 照常重新预检。
+    with session.begin():
+        with session.begin_nested():
+            links.save_link(_mk_link(a, "B", target=b))
+        assert counter.count("distinct") == 1
+        # ② savepoint 内插入异版本行后 rollback → 下一次预检读到回滚后的真实集合。
