+    assert session is same_session  # ③ Session 自始至终同一个
+    assert counter.count("distinct") == n1 + 1  # ① 确实重新 DISTINCT
+    _assert_write_refused(session, before, identity, links, a)  # ② 零写入
+    counter.stop()
