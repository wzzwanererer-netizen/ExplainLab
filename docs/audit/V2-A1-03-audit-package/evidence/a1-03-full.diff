+    requires_replan: bool
+
+
+class LinkStaleReason(BaseModel):
+    """门禁 C 的一条过期原因（稳定 reason_code + 脱敏摘要）。"""
+
+    model_config = ConfigDict(frozen=True)
+
+    reason_code: str
+    link_id: UUID | None = None
+    field: str | None = None
