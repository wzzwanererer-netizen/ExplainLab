+def _plan_ready(links: SQLAlchemyLinkRepository, session: Session, target: int = 2) -> LinkRebuildPlan:
+    plan = LinkKeyRebuild(links).plan(target)
+    # plan() 经仓库 autobegin 读事务；apply 要求无活动事务 → 先 commit。
+    session.commit()
+    assert plan.status == "ready"
+    return plan
+
