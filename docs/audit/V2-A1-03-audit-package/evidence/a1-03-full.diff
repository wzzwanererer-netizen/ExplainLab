+        links.save_link(_mk_link(a, "D"))
+        nested2.commit()
+        assert session.in_transaction()  # 外层仍活动
+        assert session.get_transaction() is not None
+        links.save_link(_mk_link(a, "E"))  # 外层后续写入仍重新预检
