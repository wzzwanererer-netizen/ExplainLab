+class StorageLockORM(Base):
+    """storage_key 租约锁表（V2 A1，SQLite 适配层用；PG 走 advisory lock）。
+
+    租约式逻辑锁：短事务条件写入（新锁或过期接管）+ 单调 lease_token fencing +
